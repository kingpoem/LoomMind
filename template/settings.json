{
  "description": "LoomMind global settings",
  "llm": {
    "provider": "openrouter",
    "openrouter": {
      "api_key": "",
      "base_url": "https://openrouter.ai/api/v1",
      "available_models": [
        "deepseek/deepseek-chat",
        "deepseek/deepseek-chat-v3.1",
        "qwen/qwen3-30b-a3b"
      ],
      "default_model": "deepseek/deepseek-chat"
    },
    "ollama": {
      "base_url": "",
      "default_origin": "http://127.0.0.1:11434",
      "model": "",
      "fallback_model": "llama3.2"
    },
    "deepseek": {
      "api_key": "",
      "base_url": "https://api.deepseek.com",
      "available_models": [
        "deepseek-v4-flash",
        "deepseek-v4-pro"
      ],
      "default_model": "deepseek-v4-flash"
    }
  },
  "planning": {
    "max_cycles": null,
    "default_max_cycles": 12,
    "max_cycles_cap": 64,
    "short_term_limit": 8,
    "trace_limit": 16,
    "task_outline_max": 12
  },
  "context": {
    "token_context_limit": 100000,
    "compass_keep_last": 8,
    "auto_compress_ratio": 0.8,
    "auto_compress_max_rounds": 3
  },
  "feishu": {
    "app_id": "",
    "app_secret": "",
    "verification_token": "",
    "user_access_token": "",
    "encrypt_key": "",
    "user_open_id": ""
  },
  "trust": {
    "trusted_paths": []
  },
  "tools": {
    "sandbox_mode": "workspace_write"
  }
}